{
  "name": "app-builder-workspace",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "node scripts/with-app-env.mjs vite build",
    "build:cloudflare": "NITRO_PRESET=cloudflare_pages node scripts/with-app-env.mjs vite build",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:app && node --test 'scripts/**/*.test.mjs'",
    "test:app": "node --experimental-strip-types --test src/lib/rank-sentence.test.ts src/lib/map-url.test.ts src/lib/safety-metrics.test.ts src/lib/metrics-derive.test.ts src/lib/community-derive.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "data:bocsar": "node scripts/fetch-bocsar-safety.mjs",
    "data:polygons": "node scripts/fetch-sal-polygons.mjs",
    "data:census": "node scripts/fetch-census-2021.mjs",
    "data:housing": "node scripts/fetch-dcj-housing.mjs",
    "data:sitemap": "node scripts/build-sitemap.mjs",
    "data:metrics": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-suburb-metrics.mjs",
    "data:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-data.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/router-plugin": "^1.168.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "maplibre-gl": "^6.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "exceljs": "^4.4.0",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  }
}
